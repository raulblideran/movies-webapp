# Copy to .env.dev (git-ignored) and fill in. Passed to the dev container by dev.sh.
Tmdb__ApiKey=
# Set to false to allow signing in without MFA enrolled (not recommended).
Auth__RequireMfa=true
# CeX: locally, CeX calls go through the cex-proxy Worker and the background price jobs are off
# (appsettings.Development.json), so your home connection never calls CeX directly. CeX blocks
# addresses that call its API a lot. Override here only if you really need to:
# Cex__ProxyUrl=https://cex-proxy.raul-blideran98.workers.dev
# Cex__BackgroundRefresh=false
